{
 "meta": {
  "name": "SpamWall",
  "version": "0.3.0",
  "country": "IN",
  "matching": "national number without +91 or leading 0",
  "license": "MIT",
  "repo": "https://github.com/wasimness/spamwall"
 },
 "rules": [
  {
   "type": "allow",
   "id": "IN-1601",
   "kind": "pattern",
   "value": "^1601\\d{6}$",
   "description": "Official series for utilities, courier and logistics (deliveries)",
   "source": "TRAI Direction 10-08-2026",
   "priority": 15,
   "group": ""
  },
  {
   "type": "allow",
   "id": "IN-AMAZON",
   "kind": "pattern",
   "value": "^2263257863$",
   "description": "Amazon India customer service",
   "source": "public number",
   "priority": 15,
   "group": ""
  },
  {
   "type": "block",
   "id": "IN-140",
   "kind": "pattern",
   "value": "^140\\d{7}$",
   "description": "Promotional / telemarketing series",
   "source": "TRAI TCCCPR 2018; RBI circular 2025-01 (140 = promotional only)",
   "priority": 5,
   "group": "telemarketing"
  },
  {
   "type": "block",
   "id": "IN-BULK-MOBILE",
   "kind": "pattern",
   "value": "^(657350|731361|914714|922807|942209|948470)\\d{4}$",
   "description": "Bulk telemarketing mobile ranges",
   "source": "clustered from community spam reports",
   "priority": 5,
   "group": "spam-mobiles"
  },
  {
   "type": "block",
   "id": "IN-CC-BLR",
   "kind": "pattern",
   "value": "^(803710|803720|804795|804819|806935|806954|806985)\\d{4}$",
   "description": "Bengaluru call-centre blocks",
   "source": "clustered from community spam reports",
   "priority": 5,
   "group": "call-centres"
  },
  {
   "type": "block",
   "id": "IN-CC-LANDLINE",
   "kind": "pattern",
   "value": "^(1725|2250|2269|3366|3368|3371|4071|7935|7969|7971)\\d{6}$",
   "description": "Call-centre landline ranges (Chandigarh, Mumbai, Kolkata, Hyderabad, Ahmedabad)",
   "source": "clustered from community spam reports",
   "priority": 5,
   "group": "call-centres"
  },
  {
   "type": "optional",
   "id": "IN-1600",
   "kind": "pattern",
   "value": "^1600\\d{6}$",
   "description": "Official BFSI + Government service/transactional series. Blocks REAL bank, insurer, broker and govt calls too. Enable only if you add your own banks to allow.txt",
   "source": "TRAI Direction (PIB PRID 2191647)",
   "priority": 5,
   "group": "banks-govt"
  },
